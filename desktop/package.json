{
  "name": "korczak-nexus-desktop",
  "productName": "Korczak Nexus",
  "version": "0.0.293",
  "description": "Cliente Desktop nativo do Korczak Nexus",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "npm run build:engine && electron .",
    "test": "node --test",
    "build": "npm run build:engine && electron-builder --dir",
    "dist": "npm run build:engine && electron-builder",
    "dist:win": "npm run build:engine && electron-builder --win nsis",
    "dist:mac": "npm run build:engine && electron-builder --mac dmg",
    "dist:linux": "npm run build:engine && electron-builder --linux",
    "build:engine": "node scripts/build-engine.mjs"
  },
  "devDependencies": {
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "esbuild": "0.25.5"
  },
  "build": {
    "appId": "com.korczaktech.nexus.desktop",
    "productName": "Korczak Nexus",
    "artifactName": "Korczak-HUB-Nexus-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "dmg": {
      "title": "Korczak Nexus"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    }
  },
  "author": {
    "name": "Korczak Technologies",
    "email": "korczaktechnology@gmail.com"
  },
  "homepage": "https://github.com/korczaktech/kz-nexus"
}
