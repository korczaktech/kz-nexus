{
  "name": "@korczak/nexus-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Motor próprio e headless do editor Korczak Nexus, com formato nativo .nsx",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node build.mjs",
    "test": "vitest run",
    "memory:baseline": "node tooling/memory-baseline.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.5",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
