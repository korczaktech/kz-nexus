# Korczak Nexus cloud storage OAuth
# Google Cloud OAuth Client ID for a Web application.
VITE_GOOGLE_CLIENT_ID=

# Microsoft Entra App Registration Application (client) ID.
VITE_ONEDRIVE_CLIENT_ID=

# OAuth redirect URI must match the deployed Nexus origin/path.
# For GitHub Pages, use the exact Nexus PWA URL shown in the browser.
