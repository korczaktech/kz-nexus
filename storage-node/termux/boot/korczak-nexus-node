#!/data/data/com.termux/files/usr/bin/sh
set -eu

NODE_DIR="$HOME/kz-nexus/storage-node"
STATE_DIR="$HOME/.local/state/korczak-nexus"
LOG_FILE="$STATE_DIR/agent.log"
PID_FILE="$STATE_DIR/agent.pid"

mkdir -p "$STATE_DIR"
chmod 700 "$STATE_DIR"

# Avoid launching a second agent if the previous process is still alive.
if [ -f "$PID_FILE" ]; then
  OLD_PID="$(cat "$PID_FILE" 2>/dev/null || true)"
  if [ -n "$OLD_PID" ] && kill -0 "$OLD_PID" 2>/dev/null; then
    exit 0
  fi
  rm -f "$PID_FILE"
fi

if [ ! -f "$HOME/.config/korczak-nexus/node.json" ]; then
  echo "Nexus node config missing; skipping startup." >> "$LOG_FILE"
  exit 1
fi

if [ ! -f "$NODE_DIR/package.json" ]; then
  echo "Nexus storage-node project missing at $NODE_DIR." >> "$LOG_FILE"
  exit 1
fi

cd "$NODE_DIR"
nohup node src/agent.js >> "$LOG_FILE" 2>&1 &
echo "$!" > "$PID_FILE"
chmod 600 "$PID_FILE" "$LOG_FILE"
