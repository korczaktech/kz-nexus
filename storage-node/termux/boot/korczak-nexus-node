#!/data/data/com.termux/files/usr/bin/sh
set -eu

REPO_DIR="$HOME/kz-nexus"
STATE_DIR="$HOME/.local/state/korczak-nexus"
LOG_FILE="$STATE_DIR/agent.log"
PID_FILE="$STATE_DIR/agent.pid"
SUPERVISOR="$REPO_DIR/storage-node/termux/supervise-node.sh"

mkdir -p "$STATE_DIR"
chmod 700 "$STATE_DIR"

if [ -f "$PID_FILE" ]; then
  OLD_PID="$(cat "$PID_FILE" 2>/dev/null || true)"
  if [ -n "$OLD_PID" ] && kill -0 "$OLD_PID" 2>/dev/null; then
    exit 0
  fi
  rm -f "$PID_FILE"
fi

if command -v pgrep >/dev/null 2>&1; then
  RUNNING_PID="$(pgrep -f '[s]upervise-node.sh' | head -n 1 || true)"
  if [ -n "$RUNNING_PID" ]; then
    echo "$RUNNING_PID" > "$PID_FILE"
    chmod 600 "$PID_FILE"
    exit 0
  fi
fi

if [ ! -f "$HOME/.config/korczak-nexus/node.json" ]; then
  echo "Nexus node config missing; skipping startup." >> "$LOG_FILE"
  exit 1
fi

if [ ! -f "$SUPERVISOR" ]; then
  echo "Nexus supervisor missing at $SUPERVISOR." >> "$LOG_FILE"
  exit 1
fi

nohup sh "$SUPERVISOR" >> "$LOG_FILE" 2>&1 &
echo "$!" > "$PID_FILE"
chmod 600 "$PID_FILE" "$LOG_FILE"
