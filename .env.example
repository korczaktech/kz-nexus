# Korczak Documents — development
APP_ENV=development
APP_NAME=Korczak Documents
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO

# Segurança — nunca coloque valores reais neste arquivo.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=KZDocs
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000

# Google OAuth Web Client credentials (keep the secret private; configure in Render)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
